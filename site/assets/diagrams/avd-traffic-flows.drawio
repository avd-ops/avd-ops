<mxfile host="avd-ops.dev" version="1.0">
  <diagram id="AVD End-to-End Traffic Flows" name="AVD End-to-End Traffic Flows">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="user" value="End-User Device
Windows App / Web Client + avd-linecheck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="entra" value="Microsoft Entra ID &amp; Intune
