        <mxCell id="gw" value="AVD Control Plane
Workspace Feed, Gateway &amp; Broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="egress" value="NAT Gateway / Hub Firewall
Outbound 443 &amp; UDP 3478 STUN/TURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="240" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="host" value="Session Host VM (10.100.0.0/23)
