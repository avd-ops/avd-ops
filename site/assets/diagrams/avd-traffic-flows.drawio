        <mxCell id="e5" value="5. Outbound 443 / UDP 3478" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="host" target="egress"><mxGeometry relative="1" as="geometry"/></mxCell>
