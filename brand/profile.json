 "starters": {
  "page": "templates/page.html",
  "artifact": "templates/artifact.html"
 },
 "required": [
  {
   "id": "notice",
   "text": "Personal project. Research and learning only. Not for production. No warranty. Built on my own time for research and learning. Not affiliated with, endorsed by or supported by my employer or Microsoft. Don't run any of it in production or against tenants that matter. Test in a dedicated lab subscription and tenant first. Provided \"as is\", without warranty of any kind, under each repo's license. You use it at your own risk and own the Azure charges it incurs. Contributions and forks are welcome and encouraged.",
   "where": "before the first section: the notice in the shell's brand bar, which opens to the full text"
  },
  {
   "id": "credit",
   "text": "A prignano.ai production",
   "where": "last line of the footer, prignano.ai linked"
  },
  {
   "id": "trademarks",
   "text": "Every repo is open source, under MIT unless a folder says otherwise. Azure, Azure Virtual Desktop, Microsoft Entra, Intune and FSLogix are trademarks of Microsoft.",
   "where": "footer"
  }
 ],
 "voice": {
  "language": "en-US",
  "rules": [
   "American English.",
   "Plain, short sentences; say what a thing does, not how it is built.",
   "Say \"potentially paid\", never \"the product\".",
   "Results always carry a word, never color alone."
  ]
 },
 "rules": [
  "Colors only through tokens; a new color becomes a token in site/assets/avd-ops.css first, with light and dark values.",
  "Use the logo files; never redraw, recolor, stretch or add effects to the mark.",
  "Keep clear space around the mark of at least a quarter of its height.",
  "The mark is never smaller than 16px; below 24px use favicon.svg.",
  "On a light background use mark.svg or lockup.svg; on ink or darker use lockup-dark.svg or mark-white.svg.",
  "--brand is for brand surfaces; text and links use --accent.",
  "Fonts are self-hosted on pages; only an artifact loads them from Google Fonts.",
  "Pages never load avd-ops.dev or a CDN at run time; repos take a pinned copy.",
  "No partner names on avd-ops.dev for now.",
  "Private repos don't use this brand.",
  "Touch targets at least 44px; no sideways scroll at 390px; light and dark both designed."
 ]
}
