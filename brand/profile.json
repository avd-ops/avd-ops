    600,
    700
   ],
   "files": [
    "site/assets/fonts/schibsted-grotesk-latin-600-normal.woff2",
    "site/assets/fonts/schibsted-grotesk-latin-700-normal.woff2"
   ],
   "googleFonts": "Schibsted Grotesk",
   "use": "headings, in the logo's own face"
  },
  "body": {
   "family": "IBM Plex Mono",
   "fallback": "ui-monospace,\"Cascadia Mono\",SFMono-Regular,Menlo,Consolas,monospace",
   "weights": [
    400,
    600,
    700
   ],
   "files": [
    "site/assets/fonts/ibm-plex-mono-latin-400-normal.woff2",
    "site/assets/fonts/ibm-plex-mono-latin-400-italic.woff2",
    "site/assets/fonts/ibm-plex-mono-latin-600-normal.woff2",
    "site/assets/fonts/ibm-plex-mono-latin-700-normal.woff2"
   ],
   "googleFonts": "IBM Plex Mono",
   "use": "running text at 15.5px, controls and labels in sentence case"
  },
  "mono": {
   "family": "IBM Plex Mono",
   "fallback": "ui-monospace,\"Cascadia Mono\",SFMono-Regular,Menlo,Consolas,monospace",
   "weights": [
    400,
    600
   ],
   "files": [
    "site/assets/fonts/ibm-plex-mono-latin-400-normal.woff2",
    "site/assets/fonts/ibm-plex-mono-latin-600-normal.woff2"
   ],
   "googleFonts": "IBM Plex Mono",
   "use": "code and commands"
  },
  "wordmark": {
   "family": "Schibsted Grotesk",
   "fallback": "\"Segoe UI\",system-ui,sans-serif",
   "weights": [
    700
   ],
   "files": [
    "site/assets/fonts/schibsted-grotesk-latin-700-normal.woff2"
   ],
   "googleFonts": "Schibsted Grotesk",
   "use": "the word avd-ops in the logo and the brand bar only",
   "case": "the brand is always lowercase: avd-ops"
  },
  "tagline": {
   "family": "JetBrains Mono",
   "fallback": "ui-monospace,Menlo,Consolas,monospace",
   "weights": [
    600
   ],
   "files": [
    "site/assets/fonts/jetbrains-mono-latin-600-normal.woff2"
   ],
   "googleFonts": "JetBrains Mono",
   "use": "the tagline Deploy quietly in the logo only",
