{
  "$comment": "One routing table for every submission to the AVD repos (docs/submissions-spec.md). Repos are named by their key in repos.json. Each public route opens an issue form from submissions/forms/ in that repo; private routes are a mailto to the mailbot and never a public issue. The foundation repos vendor this file, the forms they use and links.mjs byte-identical at a pinned commit; nothing reads it at run time from avd-ops.",
  "version": 1,
  "always": ["submission", "needs-triage"],
  "mail": {
    "address": "hello@avd-ops.dev",
    "status": "working name; the mailbot is not built, so private routes show the address only until it is"
  },
  "types": {
    "evidence": {"title": "Evidence", "public": true},
    "research": {"title": "Research source", "public": true},
    "research-request": {"title": "Research request", "public": true},
    "feedback": {"title": "Feedback, disputes and fact checks", "public": true},
    "bug": {"title": "Bug report", "public": true},
    "feature": {"title": "Feature request", "public": true},
    "contact": {"title": "General contact", "public": false, "subject": "[contact]"},
    "sponsorship": {"title": "Sponsorship inquiry", "public": false, "subject": "[sponsorship]", "explainer": "https://avd-ops.dev/funding.html", "gated": "the funding page and this button wait on Nick's go"}
  },
  "routes": [
    {"type": "evidence", "area": "assess.baselines", "repo": "avd-assess", "form": "baseline-evidence.yml"},
    {"type": "evidence", "area": "assess.finding", "repo": "avd-assess", "form": "finding.yml"},
    {"type": "research", "area": "assess.references", "repo": "avd-assess", "form": "research.yml"},
    {"type": "research", "area": "assess.gold-standards", "repo": "avd-assess", "form": "research.yml", "triage": ["gold-standards"]},
    {"type": "research-request", "area": "assess.gap", "repo": "avd-assess", "form": "research-request.yml", "triage": ["gap:<id>"]},
    {"type": "research-request", "area": "other", "repo": "avd-ops", "form": "research-request.yml"},
    {"type": "feedback", "area": "assess", "repo": "avd-assess", "form": "feedback.yml"},
    {"type": "feedback", "area": "assess.dispute", "repo": "avd-assess", "form": "dispute.yml"},
    {"type": "feedback", "area": "landing-zone", "repo": "avd-landing-zone", "form": "feedback.yml"},
    {"type": "feedback", "area": "landing-zone.dispute", "repo": "avd-landing-zone", "form": "dispute.yml"},
    {"type": "feedback", "area": "current-state", "repo": "avd-current-state", "form": "feedback.yml"},
    {"type": "feedback", "area": "current-state.dispute", "repo": "avd-current-state", "form": "dispute.yml"},
    {"type": "feedback", "area": "site", "repo": "avd-ops", "form": "feedback.yml"},
    {"type": "feedback", "area": "site.dispute", "repo": "avd-ops", "form": "dispute.yml"},
    {"type": "bug", "area": "assess", "repo": "avd-assess", "form": "bug.yml"},
    {"type": "bug", "area": "landing-zone", "repo": "avd-landing-zone", "form": "bug.yml"},
    {"type": "bug", "area": "current-state", "repo": "avd-current-state", "form": "bug.yml"},
    {"type": "bug", "area": "swarm", "repo": "avd-swarm", "form": "bug.yml"},
    {"type": "bug", "area": "second-brain", "repo": "avd-second-brain", "form": "bug.yml"},
    {"type": "bug", "area": "site", "repo": "avd-ops", "form": "bug.yml", "triage": ["site"]},
    {"type": "bug", "area": "kb", "repo": "avd-ops", "form": "kb-feedback.yml"},
    {"type": "bug", "area": "unsure", "repo": "avd-ops", "form": "bug.yml", "triage": ["needs-routing"]},
    {"type": "feature", "area": "assess", "repo": "avd-assess", "form": "feature.yml"},
    {"type": "feature", "area": "landing-zone", "repo": "avd-landing-zone", "form": "feature.yml"},
    {"type": "feature", "area": "current-state", "repo": "avd-current-state", "form": "feature.yml"},
    {"type": "feature", "area": "swarm", "repo": "avd-swarm", "form": "feature.yml"},
    {"type": "feature", "area": "second-brain", "repo": "avd-second-brain", "form": "feature.yml"},
    {"type": "feature", "area": "site", "repo": "avd-ops", "form": "feature.yml", "triage": ["site"]},
    {"type": "feature", "area": "unsure", "repo": "avd-ops", "form": "feature.yml", "triage": ["needs-routing"]},
    {"type": "contact", "area": "any", "mail": true},
    {"type": "sponsorship", "area": "any", "mail": true}
  ],
  "labels": {
    "submission": "From the shared submission forms (docs/submissions-spec.md)",
    "needs-triage": "Not read yet; nothing acts on it until the owner adds accepted",
    "accepted": "The owner read it and agreed to act on it",
    "needs-routing": "The submitter wasn't sure where it goes",
    "needs-redaction": "May hold private data; the author is asked to edit it",
    "needs-pin": "A research source without a pin yet",
    "needs-evidence": "A dispute with no evidence yet; stays open",
    "type:evidence": "Measured results or a real-run finding",
    "type:research": "A source or a claim from one",
    "type:research-request": "A question to research, or an offer to help",
    "type:feedback": "Praise, a problem, or a dispute",
    "type:bug": "Something does the wrong thing",
    "type:feature": "Something it should do",
    "evidence": "Baseline evidence file",
    "observation": "A real-run finding about a claim",
    "research": "A reference to add or update",
    "research-request": "Open call for research",
    "call-for-help": "We are asking for outside research",
    "feedback": "Praise or a problem",
    "dispute": "Something we publish may be wrong",
    "dispute:open": "Dispute received, not decided",
    "dispute:accepted": "We were wrong; a PR fixes it",
    "dispute:rejected": "We keep the claim; reasons in the closing comment"
  }
}
